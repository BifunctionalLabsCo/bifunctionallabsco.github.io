---
/**
 * ParallaxBand.astro: full-width photo band with text on top.
 *
 * The photo is an absolutely positioned <img> that overscans the band by
 * 15% top and bottom. A small scroll handler shifts it within that margin,
 * so the band never clips the photo, at any height, on any screen.
 *
 * Text placed inside the band uses the mint quote style (`.quote`), which
 * PostLayout defines for both `.cover-quote` and `.parallax-band`.
 *
 * Props
 * ──────────────────────────────────────────────────────────────
 * image       string   photo URL
 * alt?        string   accessible description (empty when decorative)
 * minHeight?  string   CSS min-height for desktop (default: a narrow band)
 *
 * Usage
 *   <ParallaxBand image="https://…/04.jpg" alt="Mirabell Gardens">
 *     <p class="quote">Text on top of the photo.</p>
 *   </ParallaxBand>
 */

interface Props {
  image: string;
  alt?: string;
  minHeight?: string;
}

const { image, alt = '', minHeight } = Astro.props;
---

<section
  class="parallax-band"
  style={minHeight ? `--band-h:${minHeight};` : undefined}
>
  <img class="parallax-bg" src={image} alt={alt} loading="lazy" decoding="async" />
  <div class="parallax-band-inner">
    <slot name="title" />
    <slot />
  </div>
</section>

<script>
  // Shift each band's photo inside its overscan margin as the band crosses the viewport.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bands = Array.from(document.querySelectorAll<HTMLElement>('.parallax-band'));

  function update() {
    if (reduceMotion) return;
    const vh = window.innerHeight;
    for (const band of bands) {
      const img = band.querySelector<HTMLImageElement>('.parallax-bg');
      if (!img) continue;
      const r = band.getBoundingClientRect();
      if (r.bottom < 0 || r.top > vh) continue;
      // -1 when the band enters from the bottom, +1 when it leaves at the top
      const p = ((r.top + r.height / 2) - vh / 2) / (vh / 2 + r.height / 2);
      const overscan = (img.offsetHeight - band.offsetHeight) / 2;
      img.style.transform = `translate3d(0, ${(-p * overscan).toFixed(1)}px, 0)`;
    }
  }

  let queued = false;
  window.addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; update(); });
  }, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>

<style>
  .parallax-band{
    position:relative; overflow:hidden; isolation:isolate;
    display:flex; align-items:center;
    min-height:var(--band-h, clamp(320px, 42vh, 420px));
    color:#fff;
  }
  .parallax-bg{
    position:absolute; left:0; top:-15%; z-index:-2;
    width:100%; height:130%; object-fit:cover; display:block;
    will-change:transform;
  }
  .parallax-band::before{
    content:""; position:absolute; inset:0; z-index:-1;
    background:rgba(0,0,0,.42);
  }
  .parallax-band-inner{
    position:relative; z-index:1; width:100%;
    max-width:var(--page); margin:0 auto; padding:0 var(--gutter);
  }
  .parallax-band-inner :global(p),
  .parallax-band-inner :global(h2),
  .parallax-band-inner :global(h3){ color:#fff; }
  .parallax-band-inner :global(h2.section-title){ margin-bottom:18px; }
  @media (max-width:768px){
    .parallax-band{ min-height:var(--band-h-mobile, clamp(260px, 36vh, 340px)); }
  }
  @media (prefers-reduced-motion: reduce){
    .parallax-bg{ top:0; height:100%; transform:none !important; }
  }
</style>
