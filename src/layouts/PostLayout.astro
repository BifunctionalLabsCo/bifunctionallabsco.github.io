---
/**
 * PostLayout.astro — shared layout for all travel expedition/blog post pages.
 *
 * Props
 * ──────────────────────────────────────────────────────────────
 * pageTitle        string   — <title> tag value (e.g. "Innsbruck | Expeditions")
 * heroTitle        string   — big h1 inside the hero (may contain <br>)
 * heroSubtitle     string   — italic subtitle below the title
 * seriesLabel?     string   — small label above the title (e.g. "Into the Alps — Vol. I")
 * heroStyle?       string   — inline style applied to .post-hero (background-image: url(...))
 * heroBgLabel?     string   — if set, renders a gradient placeholder div with this label
 *                             (use when there is no real hero photo yet)
 * heroBgGradient?  string   — CSS gradient for the hero placeholder background
 *                             (defaults to dark green if omitted)
 * date             string   — publication date shown in author line (e.g. "OCTOBER 9TH, 2021")
 * location         string   — article footer location text
 * locationLabel?   string   — label above location (defaults to "Location")
 * footnote         string   — small footer note / copyright line
 * moreTitle?       string   — heading inside the pink section (defaults to "More Expeditions")
 *
 * Named slots
 * ──────────────────────────────────────────────────────────────
 * nav-left         — left side of the floating nav bar (defaults to "EXPEDITIONS")
 * nav-right        — right side of the floating nav bar (defaults to ← All Expeditions link)
 * default          — article body (everything between author line and article footer)
 * more-cards       — the <a class="more-card"> elements inside the pink more-grid
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  pageTitle: string;
  heroTitle: string;
  heroSubtitle: string;
  seriesLabel?: string;
  heroStyle?: string;
  heroBgLabel?: string;
  heroBgGradient?: string;
  date: string;
  location: string;
  locationLabel?: string;
  footnote: string;
  moreTitle?: string;
}

const {
  pageTitle,
  heroTitle,
  heroSubtitle,
  seriesLabel,
  heroStyle = '',
  heroBgLabel,
  heroBgGradient = 'linear-gradient(135deg, #2c4a3e 0%, #1a3028 100%)',
  date,
  location,
  locationLabel = 'Location',
  footnote,
  moreTitle = 'More Expeditions',
} = Astro.props;
---

<BaseLayout title={pageTitle}>
  <Fragment slot="head">
    <style is:inline>
    /* ─── TOKENS ─── */
    :root{
      --black: #1b1b1b;
      --muted: rgba(27,27,27,.58);
      --faint: rgba(27,27,27,.38);
      --bg: #ffffff;
      --bg-alt: #f7f7f7;
      --border: rgba(27,27,27,.10);
      --page: 1120px;
      --text: 740px;
      --gutter: 28px;
      --gap: 22px;
      --serif: "Fraunces", serif;
      --caps: "Cormorant Garamond", serif;
      --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
      --display: "Poppins", sans-serif;
    }

    *{ box-sizing:border-box; }
    body{ margin:0; background:var(--bg); color:var(--black); font-family:var(--sans); line-height:1.7; }

    /* ─── NAV BAR ─── */
    .post-nav{
      position:absolute; top:0; left:0; right:0; z-index:10;
      display:flex; align-items:center; justify-content:space-between;
      padding:16px var(--gutter); max-width:var(--page); margin:0 auto;
    }
    .post-nav .nav-left{
      font-family:var(--sans); font-size:11px; font-weight:600;
      letter-spacing:.12em; text-transform:uppercase; color:#fff; opacity:.8;
    }
    .post-nav .nav-icons{ display:flex; gap:12px; }
    .post-nav .nav-icon{
      width:28px; height:28px; display:grid; place-items:center;
      border-radius:6px; background:rgba(255,255,255,.12);
      backdrop-filter:blur(6px); color:#fff; text-decoration:none;
      font-size:13px; transition:background .15s;
    }
    .post-nav .nav-icon:hover{ background:rgba(255,255,255,.22); }
    .post-nav .back-btn,
    .post-nav .edit-btn{
      font-family:var(--sans); font-size:11px; font-weight:700;
      letter-spacing:.1em; text-transform:uppercase; color:#fff;
      background:rgba(255,255,255,.14); backdrop-filter:blur(6px);
      padding:7px 16px; border-radius:6px; text-decoration:none;
      display:inline-flex; align-items:center; gap:6px; transition:background .15s;
    }
    .post-nav .back-btn:hover,
    .post-nav .edit-btn:hover{ background:rgba(255,255,255,.24); }

    /* ─── HERO ─── */
    .post-hero{
      position:relative; min-height:520px; display:flex;
      align-items:flex-end; background:#333 center/cover no-repeat; overflow:hidden;
    }
    .post-hero::after{
      content:""; position:absolute; inset:0;
      background:linear-gradient(to top, rgba(0,0,0,.70) 0%, rgba(0,0,0,.18) 55%, rgba(0,0,0,.12) 100%);
    }
    /* gradient placeholder used when no real hero photo exists yet */
    .hero-ph{
      position:absolute; inset:0; display:flex;
      align-items:center; justify-content:center;
    }
    .hero-ph-label{
      font-family:var(--sans); font-size:11px; font-weight:600;
      letter-spacing:.14em; text-transform:uppercase;
      color:rgba(255,255,255,.35); z-index:1;
    }
    .hero-content{
      position:relative; z-index:2; max-width:var(--page);
      margin:0 auto; padding:0 var(--gutter) 52px; width:100%; color:#fff;
    }
    .hero-content .series-label{
      font-family:var(--sans); font-size:10px; font-weight:700;
      letter-spacing:.22em; text-transform:uppercase;
      color:rgba(255,255,255,.6); margin:0 0 10px; display:block;
    }
    .hero-content .post-title{
      font-family:var(--display); font-weight:700;
      font-size:clamp(36px,5vw,56px); letter-spacing:.02em;
      text-transform:uppercase; margin:0 0 6px; max-width:18ch; line-height:1.1;
    }
    .hero-content .post-subtitle{
      font-family:var(--serif); font-style:italic;
      font-size:18px; margin:0; opacity:.85;
    }

    /* ─── AUTHOR LINE ─── */
    .author-line{
      display:flex; align-items:center; gap:14px;
      max-width:var(--text); margin:36px auto 0; padding:0 var(--gutter);
    }
    .author-avatar{
      width:42px; height:42px; border-radius:50%;
      background:#ddd; overflow:hidden; flex-shrink:0;
    }
    .author-avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
    .author-info{
      font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted);
    }
    .author-info strong{ color:var(--black); font-weight:700; letter-spacing:.14em; }
    .author-info .date{ display:block; margin-top:2px; font-size:11px; color:var(--faint); }

    /* ─── CONTAINERS ─── */
    .wrap{ max-width:var(--page); margin:0 auto; padding:0 var(--gutter); }
    .text{ max-width:var(--text); margin:0 auto; padding:0 var(--gutter); }

    /* ─── SPACING ─── */
    .space-xs{ padding:14px 0; }
    .space-sm{ padding:28px 0; }
    .space-md{ padding:44px 0; }
    .space-lg{ padding:72px 0; }

    /* ─── SECTION HEADINGS ─── */
    h2.section-title{
      font-family:var(--sans); font-size:clamp(24px,3.3vw,38px);
      letter-spacing:.08em; font-weight:800; margin:0; text-transform:uppercase;
    }
    h2.section-title-center{
      text-align:center; font-family:var(--sans);
      font-size:clamp(24px,3.3vw,38px); letter-spacing:.08em;
      font-weight:800; margin:0; text-transform:uppercase;
    }

    /* ─── TEXT ─── */
    p{ margin:16px 0; font-size:15px; color:rgba(27,27,27,.85); }
    .lede{ font-size:16px; color:rgba(27,27,27,.78); }

    /* ─── MEDIA ─── */
    figure{ margin:0; }
    img{ max-width:100%; display:block; }
    .media{
      width:100%; background:#e8eeec; overflow:hidden; position:relative;
    }
    .media img{ width:100%; height:100%; object-fit:cover; display:block; }
    figcaption{
      font-family:var(--serif); font-style:italic; text-align:center;
      margin-top:10px; font-size:13px; color:var(--faint);
    }

    /* Image placeholder: <div class="media ph" data-label="..."></div> */
    .media.ph{ background:linear-gradient(135deg, #dce8e4 0%, #c8d8d2 100%); }
    .media.ph::after{
      content:attr(data-label); position:absolute; inset:0;
      display:flex; align-items:center; justify-content:center; padding:16px;
      font-family:var(--sans); font-size:10px; font-weight:600;
      letter-spacing:.12em; text-transform:uppercase;
      color:rgba(3,43,34,.4); text-align:center;
    }

    /* ─── SINGLE / FULL-BLEED ─── */
    .single{ max-width:var(--page); margin:0 auto; padding:0 var(--gutter); }
    .single .media{ aspect-ratio:16/10; }
    .full-bleed .media{ aspect-ratio:21/9; }

    /* ─── GRIDS ─── */
    .grid{ max-width:var(--page); margin:0 auto; padding:0 var(--gutter); display:grid; gap:var(--gap); }
    .grid-2{ grid-template-columns:1fr 1fr; }
    .grid-3{ grid-template-columns:1fr 1fr 1fr; }
    .grid .media{ aspect-ratio:16/10; }
    .grid-2plus1{ grid-template-columns:1fr 1fr; grid-auto-rows:auto; }
    .span-2{ grid-column:1/-1; }
    .grid-2plus1 .span-2 .media{ aspect-ratio:21/9; }

    /* ─── COVER QUOTE ─── */
    .cover-quote{
      position:relative; min-height:340px; display:flex;
      align-items:flex-end; padding:44px var(--gutter);
      color:#fff; background:#333 center/cover no-repeat; overflow:hidden;
    }
    .cover-quote::after{
      content:""; position:absolute; inset:0;
      background:linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,.18));
    }
    /* gradient placeholder inside cover-quote */
    .cover-ph{ position:absolute; inset:0; }
    .cover-quote .inner{ position:relative; z-index:2; max-width:var(--page); margin:0 auto; width:100%; }
    .cover-quote .quote{
      font-family:var(--sans); font-weight:800; text-transform:uppercase;
      letter-spacing:.06em; line-height:1.25; font-size:clamp(16px,2.2vw,28px);
      max-width:36ch; margin:0;
    }
    .cover-quote figcaption{ text-align:left; color:rgba(255,255,255,.6); margin-top:14px; }

    /* ─── ARTICLE FOOTER ─── */
    .article-footer{
      text-align:center; padding:44px var(--gutter) 24px;
      max-width:var(--text); margin:0 auto;
    }
    .article-footer .location-label{
      font-family:var(--sans); font-size:10px; font-weight:600;
      letter-spacing:.16em; text-transform:uppercase; color:var(--faint); margin:0 0 4px;
    }
    .article-footer .location{
      font-family:var(--sans); font-weight:700; font-size:15px; margin:0 0 6px; color:var(--black);
    }
    .article-footer .footnote{ font-family:var(--caps); font-size:13px; color:var(--faint); margin:0; }
    .article-footer .share-row{ display:flex; justify-content:center; gap:10px; margin-top:18px; }
    .share-btn{
      width:32px; height:32px; border-radius:8px; display:grid; place-items:center;
      border:1px solid var(--border); background:transparent;
      text-decoration:none; transition:background .15s;
    }
    .share-btn:hover{ background:var(--bg-alt); }
    .share-btn svg{ width:14px; height:14px; fill:var(--black); }

    /* ─── MORE / PINK SECTION ─── */
    .more-section{ background:#ffafda; padding:0 var(--gutter) 64px; text-align:center; }
    .more-author{
      display:flex; align-items:center; justify-content:center;
      gap:14px; padding:36px var(--gutter) 0; margin-bottom:28px;
    }
    .more-avatar{
      width:52px; height:52px; border-radius:50%; object-fit:cover;
      border:2px solid rgba(3,43,34,.2); flex-shrink:0;
    }
    .more-author-info{ display:flex; flex-direction:column; gap:8px; align-items:flex-start; }
    .more-author-name{
      font-family:var(--sans); font-size:11px; font-weight:700;
      letter-spacing:.14em; text-transform:uppercase; color:#032b22;
    }
    .more-socials{ display:flex; gap:8px; }
    .more-social{
      width:28px; height:28px; display:grid; place-items:center;
      border-radius:6px; border:1px solid rgba(3,43,34,.22);
      background:transparent; text-decoration:none; transition:background .15s;
    }
    .more-social:hover{ background:rgba(3,43,34,.08); }
    .more-social svg{ width:13px; height:13px; fill:#032b22; }
    .more-divider{ width:60px; height:1px; background:rgba(3,43,34,.18); margin:0 auto 36px; }
    .more-title{
      font-family:var(--serif); font-style:italic;
      font-size:24px; color:#032b22; margin:0 0 28px;
    }
    .more-grid{
      display:grid; grid-template-columns:repeat(3,1fr);
      gap:22px; max-width:var(--page); margin:0 auto;
    }
    .more-card{ text-decoration:none; color:#032b22; transition:transform .2s; }
    .more-card:hover{ transform:translateY(-3px); }
    .more-card .more-thumb{
      border-radius:10px; overflow:hidden; aspect-ratio:4/3;
      background:rgba(3,43,34,.12); box-shadow:0 8px 24px rgba(0,0,0,.14);
    }
    .more-card .more-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
    .more-card .more-card-title{
      font-family:var(--sans); font-size:13px; font-weight:700;
      letter-spacing:.06em; text-transform:uppercase; margin:10px 0 2px; text-align:left;
    }
    .more-card .more-card-badge{
      font-family:var(--sans); font-size:9px; font-weight:700;
      letter-spacing:.14em; text-transform:uppercase;
      color:rgba(3,43,34,.5); text-align:left; display:block;
    }
    .more-card .more-card-sub{
      font-family:var(--serif); font-style:italic;
      font-size:12px; color:rgba(3,43,34,.65); margin:4px 0 0; text-align:left;
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width:860px){
      :root{ --gutter:18px; --gap:14px; }
      .grid-2, .grid-3, .grid-2plus1{ grid-template-columns:1fr; }
      .span-2{ grid-column:auto; }
      .post-hero{ min-height:420px; }
      .hero-content .post-title{ font-size:32px; }
      .more-grid{ grid-template-columns:1fr; max-width:360px; }
    }
    </style>
  </Fragment>

  <!-- FLOATING NAV -->
  <nav class="post-nav">
    <span class="nav-left"><slot name="nav-left">EXPEDITIONS</slot></span>
    <slot name="nav-right">
      <a class="back-btn" href="/expeditions/">&#8592; All Expeditions</a>
    </slot>
  </nav>

  <!-- HERO -->
  <header class="post-hero" style={heroStyle}>
    {heroBgLabel && (
      <div class="hero-ph" style={`background:${heroBgGradient}`}>
        <span class="hero-ph-label">{heroBgLabel}</span>
      </div>
    )}
    <div class="hero-content">
      {seriesLabel && <span class="series-label">{seriesLabel}</span>}
      <h1 class="post-title" set:html={heroTitle} />
      <p class="post-subtitle">{heroSubtitle}</p>
    </div>
  </header>

  <!-- AUTHOR LINE -->
  <div class="author-line">
    <div class="author-avatar">
      <img src="/assets/images/00z.jpg" alt="Zubin John" />
    </div>
    <div class="author-info">
      By <strong>ZUBIN JOHN</strong>
      <span class="date">{date}</span>
    </div>
  </div>

  <!-- ARTICLE BODY -->
  <slot />

  <!-- ARTICLE FOOTER -->
  <div class="article-footer">
    <p class="location-label">{locationLabel}</p>
    <p class="location">{location}</p>
    <p class="footnote">{footnote}</p>
    <div class="share-row">
      <a class="share-btn" href="#" aria-label="Bookmark">
        <svg viewBox="0 0 24 24"><path d="M5 4a2 2 0 012-2h10a2 2 0 012 2v18l-7-3.5L5 22V4z"/></svg>
      </a>
      <a class="share-btn" href="#" aria-label="Share on X">
        <svg viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
      </a>
    </div>
  </div>

  <!-- PINK MORE SECTION -->
  <section class="more-section">
    <div class="more-author">
      <img class="more-avatar" src="/assets/images/00z.jpg" alt="Zubin John" />
      <div class="more-author-info">
        <span class="more-author-name">Zubin John</span>
        <div class="more-socials">
          <a class="more-social" href="https://www.linkedin.com/in/zubin-john-953b4241/" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a class="more-social" href="https://bsky.app/profile/bifunctional.bsky.social" aria-label="Bluesky" target="_blank" rel="noopener">
            <svg viewBox="0 0 568 501"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.463-7.158-3.614-10.49-3.631-7.647-.017 2.843-1.168 6.189-3.631 13.347-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.889-129.52 80.654-149.07-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.66 0 75.293 0 57.947 0-28.906 76.134-1.611 123.121 33.664z"/></svg>
          </a>
          <a class="more-social" href="https://www.instagram.com/zrjohn/" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 100 12.324 6.162 6.162 0 100-12.324zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 11-2.88 0 1.441 1.441 0 012.88 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="more-divider"></div>
    <h2 class="more-title">{moreTitle}</h2>
    <div class="more-grid">
      <slot name="more-cards" />
    </div>
  </section>
</BaseLayout>
