---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Greetings Wanderer - We are bifunctional"
  description="A Berlin-based freelance studio guiding founders from idea to design, build, and launch. Product, software, data, and design under one compact team."
>
  <Fragment slot="head">
    <style is:inline>
    :root{
      /* Approx palette based on the PDF */
       --teal-400:#40ffb5;
      --teal-600: #00634d;
      --teal-800: #032b22;
      --cream: #efede7;
      --pink: #ffafda;
     
      --white:#ffffff;
      --muted:#6e6e6e;

      --max: 1120px;
      --gutter: 28px;

      --serif: "Fraunces", serif;
      --caps: "Cormorant Garamond", serif;
      --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;

      --shadow: 0 18px 40px rgba(0,0,0,.18);
      --shadow-soft: 0 10px 30px rgba(0,0,0,.12);
      --radius: 10px;
      --radius-lg: 14px;
    }

    *{box-sizing:border-box}
    html{height:100%;overscroll-behavior:none;scroll-behavior:smooth}
    body{height:100%;
      margin:0;
      color:var(--teal-800);
      background:var(--cream);
      font-family:var(--sans);
      line-height:1.45;
    }

    /* Helpers */
    .wrap{
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter);
    }
    .section{
      padding: 80px 0;
    }
    .two-col{
      display:grid;
      grid-template-columns: 1.05fr 1.35fr;
      gap: 48px;
      align-items:center;
    }
    .two-col.image-left{
      grid-template-columns: 1.35fr 1.05fr;
    }
    .media{
      width:100%;
      border-radius: var(--radius-lg);
      overflow:hidden;
      box-shadow: var(--shadow-soft);
      background:#ddd;
      aspect-ratio: 16 / 9;
      position:relative;
    }
    .media img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
      transition: transform .4s ease;
    }
    .media:hover img{
      transform: scale(1.03);
    }

    /* Circular portrait cutout */
    .portrait-circle{
      border-radius: 50%;
      aspect-ratio: 1 / 1;
      box-shadow: 0 24px 60px rgba(0,0,0,.4);
      max-width: 85%;
      justify-self: center;
    }
    .portrait-circle img{
      transform: scale(1.15);
    }
    .portrait-circle:hover img{
      transform: scale(1.18);
    }

    /* HERO */
    .hero{
      min-height: 85svh;
      background:
        linear-gradient(to bottom, rgba(0,0,0,.28) 0%, rgba(0,0,0,.52) 100%),
        url("assets/hero.png") center/cover no-repeat;
      display:flex;
      align-items:center;
      position:relative;
      overflow:hidden;
      box-shadow: 0 8px 40px rgba(0,0,0,.25);
    }

    /* bottom fade into first section */
    .hero-fade{
      position:absolute;
      bottom:0; left:0; right:0;
      height: 120px;
      background: linear-gradient(to bottom, transparent, var(--teal-800));
      pointer-events:none;
      z-index:1;
    }

    /* logo sigil */
    .hero::after{
      content:"";
      position:absolute;
      top: 28px;
      left: 50%;
      transform: translateX(-50%);
      width: 72px;
      height: 72px;
      background: url("assets/logo.png") center/contain no-repeat;
      filter: drop-shadow(0 10px 20px rgba(0,0,0,.35));
      pointer-events:none;
    }

    .hero-inner{
      width:100%;
      max-width: var(--max);
      margin: 0 auto;
      text-align:center;
      color:var(--white);
      padding: 140px var(--gutter) 120px;
      position:relative;
      z-index:2;
    }

    /* descriptor pills */
    .hero-pills{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap: 10px;
      margin: 20px 0 28px;
    }
    .hero-pill{
      display:inline-flex;
      align-items:center;
      gap: 6px;
      padding: 6px 14px;
      border: 1px solid rgba(64,255,181,.30);
      border-radius: 999px;
      background: rgba(64,255,181,.07);
      backdrop-filter: blur(4px);
      font-family: "Montserrat", sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--teal-400);
    }
    .hero-pill-dot{
      width: 6px; height: 6px;
      border-radius: 999px;
      background: var(--teal-400);
      flex-shrink:0;
    }

    /* scroll cue */
    .hero-scroll{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap: 6px;
      margin-top: 40px;
      opacity: .55;
    }
    .hero-scroll span{
      font-family: "Montserrat", sans-serif;
      font-size: 10px;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--teal-400);
    }
    .hero-scroll-line{
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, var(--teal-400), transparent);
      animation: scrollpulse 2s ease-in-out infinite;
    }
    @keyframes scrollpulse{
      0%,100%{ opacity:.55; transform:scaleY(1); }
      50%{ opacity:1; transform:scaleY(1.1); }
    }
    @media (prefers-reduced-motion: reduce){
      .hero-scroll-line{ animation:none; }
    }

    .hero-kicker{
      font-family: var(--caps);
      text-transform: uppercase;
      font-size: 24px;
      opacity:.9;
      margin: 0 0 18px;
    }

    .hero-we-are{
      font-family: var(--serif);
      font-size: clamp(28px, 6vw, 80px);
      margin: 0 0 4px;
      letter-spacing: .04em;
      color: var(--pink);
    }

    .hero-title{
      font-family: "Poppins", sans-serif;
      font-weight: 600;
      font-size: clamp(42px, 10vw, 88px);
      margin: 0 0 8px;
      letter-spacing: .02em;
      text-transform: lowercase;
      text-shadow: 0 10px 24px rgba(0,0,0,.35);
      word-break: break-word;
    }

    .hero-subtitle{
      max-width: 640px;
      margin: 0 auto 20px;
      font-family: var(--caps);
      font-size: clamp(14px, 3.5vw, 24px);
      color:var(--teal-400);
      opacity:.92;
      padding: 0 8px;
    }

    .hero-flag{
      display:inline-block;
      margin-left: 6px;
      filter: drop-shadow(0 8px 18px rgba(0,0,0,.35));
    }

    .hero-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 12px 22px;
      font-family: var(--caps);
      letter-spacing: .18em;
      text-transform: uppercase;
      font-size: 16px;
      color: var(--teal-400);
      border: 2px solid rgba(64,255,181,.35);
      border-radius: 10px;
      text-decoration:none;
      backdrop-filter: blur(6px);
      background: rgba(64,255,181,.08);
      transition: transform .18s ease, background .18s ease;
      margin-top: 10px;
    }
    .hero-btn:hover{
      transform: translateY(-1px);
      background: rgba(64,255,181,.15);
    }

    /* SECTION: Zubin */
    .panel-cream{
      background: var(--cream);
      position:relative;
      box-shadow: 0 -4px 24px rgba(0,0,0,.06);
      z-index:1;
      padding: 100px 0;
    }
    .heading-small{
      font-family: var(--serif);
      color: var(--teal-600);
      font-weight: 500;
      font-style: italic;
      font-size: 42px;
      margin: 0 0 15px;
      letter-spacing: .02em;
      line-height: 1.05;
    }
    .subcaps{
      font-family: "Montserrat", sans-serif;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-size: 18px;
      font-weight: 500;
      margin: 0;
      opacity:.85;
    }
    .subcaps + .subcaps{ margin-top: 6px; }

    .body-copy{
      font-family: var(--caps);
      color: var(--teal-800);
      font-size: 20px;
      margin: 18px 0 0;
      max-width: 52ch;
      font-weight: 600;
      line-height: 1.55;
    }

    /* SECTION: Saumya dark panel */
    .panel-dark{
      background: var(--teal-800);
      color: var(--cream);
      position:relative;
      box-shadow: inset 0 8px 24px rgba(0,0,0,.18);
      padding: 100px 0;
    }
    .panel-dark .heading-small{
      color: var(--cream);
    }
    .panel-dark .subcaps{
      color: var(--cream);
      opacity: .92;
    }
    .panel-dark .body-copy{
      color: var(--cream);
    }

    /* STUDIO SERVICES */
    .services{
      background: var(--teal-800);
      color: var(--cream);
      position:relative;
      box-shadow: inset 0 12px 28px rgba(0,0,0,.15);
      overflow:hidden;
    }
    .services::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(135deg, rgba(64,255,181,.08), transparent 34%),
        radial-gradient(circle at 78% 12%, rgba(255,175,218,.18), transparent 28%);
      pointer-events:none;
    }
    .services .wrap{
      position:relative;
    }
    .services-header{
      text-align:center;
      margin: 0 auto 36px;
      max-width: 720px;
    }
    .services-title{
      font-family: var(--serif);
      font-size: 42px;
      font-weight: 600;
      font-style: italic;
      margin: 0 0 10px;
      color: var(--cream);
      letter-spacing: .01em;
    }
    .services-subtitle{
      font-family: var(--sans);
      font-size: 14px;
      margin: 0;
      color: var(--cream);
      opacity: .8;
    }
    .services .wrap{
      max-width: 1380px;
    }
    .services-grid{
      display:grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 28px;
      align-items:stretch;
    }
    .service-card{
      border: none;
      border-top: 4px solid var(--teal-400);
      border-radius: 14px;
      padding: 36px 30px 34px;
      background: rgba(255,255,255,.1);
      color: var(--cream);
      box-shadow: 0 14px 34px rgba(0,0,0,.18);
      backdrop-filter: blur(6px);
      transition: transform .2s ease, box-shadow .2s ease;
      position:relative;
      overflow:hidden;
      min-height:100%;
    }
    .service-card::before{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(145deg, rgba(255,255,255,.12), transparent 38%);
      pointer-events:none;
    }
    .service-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 20px 44px rgba(0,0,0,.2);
    }
    .service-card > *{
      position:relative;
    }
    .service-icon{
      width: 42px;
      height: 42px;
      display:grid;
      place-items:center;
      margin: 0 0 14px;
      border-radius: 50%;
      border: 1px solid rgba(64,255,181,.28);
      background: rgba(3,43,34,.28);
      color: var(--teal-400);
      font-family: var(--serif);
      font-size: 19px;
      font-weight: 600;
      margin-bottom: 14px;
    }
    .service-name{
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 600;
      text-align:left;
      margin: 0 0 12px;
      letter-spacing: .01em;
      color: var(--teal-400);
    }
    .service-meta{
      font-family: "Montserrat", sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      text-align:left;
      margin: 0 0 16px;
    }
    .service-copy{
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.55;
      text-align:left;
      margin: 0 0 14px;
      color: var(--cream);
      opacity: .88;
    }
    .service-copy + .service-copy{ margin-top: 8px; }
    .service-price{
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 600;
      text-align:left;
      margin: 18px 0 0;
      color: var(--teal-400);
    }
    .service-list{
      display:grid;
      gap: 8px;
      margin: 18px 0 0;
      padding: 0;
      list-style:none;
    }
    .service-list li{
      font-family: var(--sans);
      font-size: 12px;
      line-height:1.45;
      color: rgba(239,237,231,.86);
      padding-left: 18px;
      position:relative;
    }
    .service-list li::before{
      content:"";
      width: 6px;
      height: 6px;
      border-radius:999px;
      background: var(--pink);
      position:absolute;
      left:0;
      top:.55em;
    }
    .service-card.accent-pink{
      border-top-color: var(--pink);
    }
    .service-card.accent-pink .service-name{
      color: var(--pink);
    }
    .service-card.accent-pink .service-price{
      color: var(--pink);
    }
    .service-card.accent-pink .service-icon{
      border-color: rgba(255,175,218,.28);
      color: var(--pink);
    }

    /* decorative heading rule */
    .heading-rule{
      width: 40px;
      height: 3px;
      border-radius: 2px;
      background: var(--teal-400);
      margin: 12px 0 18px;
    }
    .panel-dark .heading-rule{
      background: var(--teal-400);
    }
    .panel-pink .heading-rule{
      background: var(--teal-800);
    }

    /* open-to-projects status chip */
    .status-chip{
      display:inline-flex;
      align-items:center;
      gap: 7px;
      padding: 4px 12px 4px 8px;
      border-radius: 999px;
      border: 1px solid rgba(0,99,77,.28);
      background: rgba(0,99,77,.08);
      font-family: "Montserrat", sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--teal-600);
      margin-bottom: 16px;
    }
    .panel-dark .status-chip{
      border-color: rgba(64,255,181,.28);
      background: rgba(64,255,181,.08);
      color: var(--teal-400);
    }
    .status-chip-dot{
      width: 7px; height: 7px;
      border-radius:999px;
      background: var(--teal-400);
      box-shadow: 0 0 6px rgba(64,255,181,.7);
      flex-shrink:0;
    }
    .panel-cream .status-chip-dot{
      background: var(--teal-600);
      box-shadow: none;
    }

    .services-cta{
      text-align:center;
      margin-top: 36px;
    }
    .service-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--teal-400);
      color: var(--teal-800);
      font-family: "Montserrat", sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      border: 2px solid var(--teal-400);
      border-radius: 10px;
      text-decoration:none;
      transition: transform .15s ease, background .15s ease;
    }
    .service-btn:hover{
      transform: translateY(-1px);
      background: #33e6a3;
    }
    .blog-link{ display:inline-flex; }

    .section-cta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 12px 26px;
      font-family: var(--caps);
      letter-spacing: .14em;
      text-transform: uppercase;
      font-size: 15px;
      border-radius: 8px;
      text-decoration:none;
      transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
      margin-top: 24px;
    }
    .section-cta:hover{
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,.12);
    }
    .section-cta-cream{
      color: var(--teal-600);
      border: 2px solid rgba(0,99,77,.35);
      background: rgba(0,99,77,.08);
    }
    .section-cta-cream:hover{
      background: rgba(0,99,77,.15);
    }
    .section-cta-dark{
      color: var(--teal-400);
      border: 2px solid rgba(64,255,181,.35);
      background: rgba(64,255,181,.08);
    }
    .section-cta-dark:hover{
      background: rgba(64,255,181,.15);
    }

    .title-script{
      font-family: var(--serif);
      color: var(--teal-400);
      font-size: 42px;
      font-weight: 600;
      line-height: 1.05;
      margin: 0 0 15px;
      letter-spacing: .02em;
      font-style: italic;
    }

    /* TRAVEL + EXPEDITIONS */
    .panel-pink{
      background: var(--pink);
      color: var(--teal-800);
      position:relative;
      box-shadow: 0 -4px 20px rgba(0,0,0,.06), inset 0 6px 20px rgba(0,0,0,.04);
      z-index:1;
    }
    .exp-title{
      text-align:center;
      font-family: var(--serif);
      font-style: italic;
      font-weight: 600;
      font-size: 42px;
      margin: 0 0 8px;
      color: var(--teal-800);
    }
    .travel-title{
      font-family: "Montserrat", sans-serif;
      font-weight:500;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-size: 18px;
      text-align:center;
      margin: 0 0 22px;
      color: var(--teal-800);
    }
    .travel-hero{
      max-width: 560px;
      margin: 0 auto 10px;
      text-align:center;
    }
    .travel-hero .media{
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
    }
    .caption{
      font-family: var(--serif);
      font-size: 14px;
      color: var(--teal-800);
      margin: 12px auto 0;
      max-width: 74ch;
      font-style: italic;
      text-align:center;
      line-height: 1.45;
    }
    .travel-quote{
      position: relative;
      margin: 28px auto 0;
      max-width: 52ch;
      padding: 22px 28px 22px 32px;
      background: rgba(3,43,34,.07);
      border-radius: 10px;
      text-align: left;
    }
    .travel-quote::before{
      content: "\201C";
      position: absolute;
      top: -10px;
      left: 18px;
      font-family: var(--serif);
      font-size: 72px;
      line-height: 1;
      color: var(--teal-600);
      opacity: .28;
      pointer-events: none;
    }
    .travel-quote p{
      font-family: var(--serif);
      font-size: clamp(17px, 2.2vw, 21px);
      font-style: italic;
      font-weight: 500;
      color: var(--teal-800);
      line-height: 1.55;
      margin: 0;
    }
    .travel-quote cite{
      display: block;
      margin-top: 12px;
      font-family: "Montserrat", sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--teal-600);
      font-style: normal;
      opacity: .75;
    }
    .exp-sub{
      text-align:center;
      font-family: var(--caps);
      font-size: 16px;
      font-weight: 600;
      color: var(--teal-800);
      margin: 24px 0 24px;
      letter-spacing: .08em;
    }
    .cards{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    .card{
      background: rgba(255,255,255,.0);
      border-radius: 12px;
      overflow:hidden;
      box-shadow: none;
    }
    .card .thumb{
      border-radius: 12px;
      overflow:hidden;
      box-shadow: var(--shadow-soft);
      aspect-ratio: 4 / 3;
      background:#ddd;
    }
    .card .thumb img{
      width:100%;
      height:100%;
      object-fit: cover;
      display:block;
    }
    .card .meta{
      text-align:center;
      margin-top: 8px;
    }
    .card .meta .kicker{
      font-family: "Montserrat", sans-serif;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-size: 12px;
      color: var(--teal-800);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .card .meta .place{
      font-family: var(--serif);
      font-size: 18px;
      color: var(--teal-800);
      font-weight: 600;
      font-style: italic;
    }

    /* FOOTER */
    .footer{
      background: var(--teal-800);
      color: var(--cream);
      padding: 80px 0 72px;
      position:relative;
      overflow:hidden;
      box-shadow: inset 0 8px 28px rgba(0,0,0,.2);
    }
    .footer .wrap{
      position:relative;
    }
    .footer h3{
      margin: 0 0 18px;
      text-align:center;
      font-family: "Montserrat", sans-serif;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-size: 24px;
      font-weight: 600;
      color: var(--teal-400);
    }
    .footer .footer-title{
      text-align:center;
      font-family: var(--serif);
      font-size: 24px;
      margin: 0 0 20px;
    }

    .footer p{
      margin: 0 auto 14px;
      text-align:center;
      font-size: 18px;
      font-weight: 400;
      max-width: 76ch;
      color: var(--cream);
    }
    .socials{
      display:flex;
      justify-content:center;
      gap: 14px;
      margin-top: 28px;
    }
    .icon-btn{
      width: 52px;
      height: 52px;
      border-radius: 999px;
      display:grid;
      place-items:center;
      border: 1.5px solid rgba(64,255,181,.25);
      background: rgba(64,255,181,.08);
      transition: transform .18s ease, background .18s ease;
      text-decoration:none;
    }
    .icon-btn:hover{
      transform: translateY(-2px);
      background: rgba(64,255,181,.16);
    }
    .icon-btn svg{
      width: 22px;
      height: 22px;
      fill: var(--teal-400);
    }

    /* right-side vertical branding */
    .watermark{
      display:none;
    }
    .footer-branding{
     position: absolute;
  top: 2%;
  right: 50px;

  /* MUST have a real box for background to render */
  width: 420px;     /* your horizontal image width (tweak) */
  height: 90px;     /* your horizontal image height (tweak) */

  transform: translateY(-50%) rotate(-90deg);
  transform-origin: right center;

  background: url("assets/footer-branding.png") center / contain no-repeat;
  opacity: .25;
  pointer-events: none;
  z-index: 2;
    }

    /* Responsive */
