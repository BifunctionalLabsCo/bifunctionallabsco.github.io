---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Greetings Wanderer - We are bifunctional">
  <Fragment slot="head">
    <style is:inline>
    :root{
      /* Approx palette based on the PDF */
       --teal-400:#40ffb5;
      --teal-600: #00634d;
      --teal-800: #032b22;
      --cream: #efede7;
      --pink: #ffafda;
     
      --white:#ffffff;
      --muted:#6e6e6e;

      --max: 1120px;
      --gutter: 28px;

      --serif: "Fraunces", serif;
      --caps: "Cormorant Garamond", serif;
      --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;

      --shadow: 0 18px 40px rgba(0,0,0,.18);
      --shadow-soft: 0 10px 30px rgba(0,0,0,.12);
      --radius: 10px;
      --radius-lg: 14px;
    }

    *{box-sizing:border-box}
    html{height:100%;overscroll-behavior:none;scroll-behavior:smooth}
    body{height:100%;
      margin:0;
      color:var(--teal-800);
      background:var(--cream);
      font-family:var(--sans);
      line-height:1.45;
    }

    /* Helpers */
    .wrap{
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter);
    }
    .section{
      padding: 80px 0;
    }
    .two-col{
      display:grid;
      grid-template-columns: 1.05fr 1.35fr;
      gap: 48px;
      align-items:center;
    }
    .two-col.image-left{
      grid-template-columns: 1.35fr 1.05fr;
    }
    .media{
      width:100%;
      border-radius: var(--radius-lg);
      overflow:hidden;
      box-shadow: var(--shadow-soft);
      background:#ddd;
      aspect-ratio: 16 / 9;
      position:relative;
    }
    .media img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
      transition: transform .4s ease;
    }
    .media:hover img{
      transform: scale(1.03);
    }

    /* Circular portrait cutout */
    .portrait-circle{
      border-radius: 50%;
      aspect-ratio: 1 / 1;
      box-shadow: 0 24px 60px rgba(0,0,0,.4);
      max-width: 85%;
      justify-self: center;
    }
    .portrait-circle img{
      transform: scale(1.15);
    }
    .portrait-circle:hover img{
      transform: scale(1.18);
    }

    /* HERO */
    .hero{
      min-height: 600px;
      background:
        linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,.45)),
        url("assets/hero.png") center/cover no-repeat;
      display:flex;
      align-items:center;
      position:relative;
      overflow:hidden;
      box-shadow: 0 8px 40px rgba(0,0,0,.25);
    }

    /* optional subtle corner mark (like a minimalist sigil/logo) */
    .hero::after{
      content:"";
      position:absolute;
      top: 28px;
      left: 50%;
      transform: translateX(-50%);
      width: 72px;
      height: 72px;
      background: url("assets/logo.png") center/contain no-repeat;
      filter: drop-shadow(0 10px 20px rgba(0,0,0,.35));
      pointer-events:none;
    }

    .hero-inner{
      width:100%;
      max-width: var(--max);
      margin: 0 auto;
      text-align:center;
      color:var(--white);
      padding: 110px var(--gutter) 72px;
    }

    .hero-kicker{
      font-family: var(--caps);
      text-transform: uppercase;
      font-size: 24px;
      opacity:.9;
      margin: 0 0 18px;
    }

    .hero-we-are{
      font-family: var(--serif);
      font-size: clamp(28px, 6vw, 80px);
      margin: 0 0 4px;
      letter-spacing: .04em;
      color: var(--pink);
    }

    .hero-title{
      font-family: "Poppins", sans-serif;
      font-weight: 600;
      font-size: clamp(42px, 10vw, 88px);
      margin: 0 0 8px;
      letter-spacing: .02em;
      text-transform: lowercase;
      text-shadow: 0 10px 24px rgba(0,0,0,.35);
      word-break: break-word;
    }

    .hero-subtitle{
      max-width: 640px;
      margin: 0 auto 20px;
      font-family: var(--caps);
      font-size: clamp(14px, 3.5vw, 24px);
      color:var(--teal-400);
      opacity:.92;
      padding: 0 8px;
    }

    .hero-flag{
      display:inline-block;
      margin-left: 6px;
      filter: drop-shadow(0 8px 18px rgba(0,0,0,.35));
    }

    .hero-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 12px 22px;
      font-family: var(--caps);
      letter-spacing: .18em;
      text-transform: uppercase;
      font-size: 16px;
      color: var(--teal-400);
      border: 2px solid rgba(64,255,181,.35);
      border-radius: 10px;
      text-decoration:none;
      backdrop-filter: blur(6px);
      background: rgba(64,255,181,.08);
      transition: transform .18s ease, background .18s ease;
      margin-top: 10px;
    }
    .hero-btn:hover{
      transform: translateY(-1px);
      background: rgba(64,255,181,.15);
    }

    /* SECTION: Zubin */
    .panel-cream{
      background: var(--cream);
      position:relative;
      box-shadow: 0 -4px 24px rgba(0,0,0,.06);
      z-index:1;
      padding: 100px 0;
    }
    .heading-small{
      font-family: var(--serif);
      color: var(--teal-600);
      font-weight: 500;
      font-style: italic;
      font-size: 42px;
      margin: 0 0 15px;
      letter-spacing: .02em;
      line-height: 1.05;
    }
    .subcaps{
      font-family: "Montserrat", sans-serif;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-size: 18px;
      font-weight: 500;
      margin: 0;
      opacity:.85;
    }
    .subcaps + .subcaps{ margin-top: 6px; }

    .body-copy{
      font-family: var(--caps);
      color: var(--teal-800);
      font-size: 20px;
      margin: 18px 0 0;
      max-width: 52ch;
      font-weight: 600;
      line-height: 1.55;
    }

    /* SECTION: Saumya dark panel */
    .panel-dark{
      background: var(--teal-800);
      color: var(--cream);
      position:relative;
      box-shadow: inset 0 8px 24px rgba(0,0,0,.18);
      padding: 100px 0;
    }
    .panel-dark .heading-small{
      color: var(--cream);
    }
    .panel-dark .subcaps{
      color: var(--cream);
      opacity: .92;
    }
    .panel-dark .body-copy{
      color: var(--cream);
    }

    /* STUDIO SERVICES */
    .services{
      background: var(--teal-800);
      color: var(--cream);
      position:relative;
      box-shadow: inset 0 12px 28px rgba(0,0,0,.15);
    }
    .services-header{
      text-align:center;
      margin: 0 auto 36px;
      max-width: 720px;
    }
    .services-title{
      font-family: var(--serif);
      font-size: 42px;
      font-weight: 600;
      font-style: italic;
      margin: 0 0 10px;
      color: var(--cream);
      letter-spacing: .01em;
    }
    .services-subtitle{
      font-family: var(--sans);
      font-size: 14px;
      margin: 0;
      color: var(--cream);
      opacity: .8;
    }
    .services-grid{
      display:grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 28px;
    }
    .service-card{
      border: none;
      border-top: 4px solid var(--teal-400);
      border-radius: 16px;
      padding: 36px 30px 34px;
      background: rgba(255,255,255,.1);
      color: var(--cream);
      box-shadow: 0 14px 34px rgba(0,0,0,.18);
      backdrop-filter: blur(6px);
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .service-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 20px 44px rgba(0,0,0,.2);
    }
    .service-icon{
      font-size: 36px;
      text-align:center;
      margin-bottom: 14px;
    }
    .service-name{
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 600;
      text-align:center;
      margin: 0 0 12px;
      letter-spacing: .01em;
      color: var(--teal-400);
    }
    .service-meta{
      font-family: "Montserrat", sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      text-align:center;
      margin: 0 0 16px;
    }
    .service-copy{
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.55;
      text-align:center;
      margin: 0 0 14px;
      color: var(--cream);
      opacity: .88;
    }
    .service-copy + .service-copy{ margin-top: 8px; }
    .service-price{
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 600;
      text-align:center;
      margin: 18px 0 0;
      color: var(--teal-400);
    }
    .services-cta{
      text-align:center;
      margin-top: 36px;
    }
    .service-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--teal-400);
      color: var(--teal-800);
      font-family: "Montserrat", sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      border: 2px solid var(--teal-400);
      border-radius: 10px;
      text-decoration:none;
      transition: transform .15s ease, background .15s ease;
    }
    .service-btn:hover{
      transform: translateY(-1px);
      background: #33e6a3;
    }
    .blog-link{ display:inline-flex; }

    .section-cta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 12px 26px;
      font-family: var(--caps);
      letter-spacing: .14em;
      text-transform: uppercase;
      font-size: 15px;
      border-radius: 8px;
      text-decoration:none;
      transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
      margin-top: 24px;
    }
    .section-cta:hover{
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,.12);
    }
    .section-cta-cream{
      color: var(--teal-600);
      border: 2px solid rgba(0,99,77,.35);
      background: rgba(0,99,77,.08);
    }
    .section-cta-cream:hover{
      background: rgba(0,99,77,.15);
    }
    .section-cta-dark{
      color: var(--teal-400);
      border: 2px solid rgba(64,255,181,.35);
      background: rgba(64,255,181,.08);
    }
    .section-cta-dark:hover{
      background: rgba(64,255,181,.15);
    }

    .title-script{
      font-family: var(--serif);
      color: var(--teal-400);
      font-size: 42px;
      font-weight: 600;
      line-height: 1.05;
      margin: 0 0 15px;
      letter-spacing: .02em;
      font-style: italic;
    }

    /* TRAVEL + EXPEDITIONS */
    .panel-pink{
      background: var(--pink);
      color: var(--teal-800);
      position:relative;
      box-shadow: 0 -4px 20px rgba(0,0,0,.06), inset 0 6px 20px rgba(0,0,0,.04);
      z-index:1;
    }
    .exp-title{
      text-align:center;
      font-family: var(--serif);
      font-style: italic;
      font-weight: 600;
      font-size: 42px;
      margin: 0 0 8px;
      color: var(--teal-800);
    }
    .travel-title{
      font-family: "Montserrat", sans-serif;
      font-weight:500;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-size: 18px;
      text-align:center;
      margin: 0 0 22px;
      color: var(--teal-800);
    }
    .travel-hero{
      max-width: 560px;
      margin: 0 auto 10px;
      text-align:center;
    }
    .travel-hero .media{
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
    }
    .caption{
      font-family: var(--serif);
      font-size: 14px;
      color: var(--teal-800);
      margin: 12px auto 0;
      max-width: 74ch;
      font-style: italic;
      text-align:center;
      line-height: 1.45;
    }
    .exp-sub{
      text-align:center;
      font-family: var(--caps);
      font-size: 16px;
      font-weight: 600;
      color: var(--teal-800);
      margin: 24px 0 24px;
      letter-spacing: .08em;
    }
    .cards{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    .card{
      background: rgba(255,255,255,.0);
      border-radius: 12px;
      overflow:hidden;
      box-shadow: none;
    }
    .card .thumb{
      border-radius: 12px;
      overflow:hidden;
      box-shadow: var(--shadow-soft);
      aspect-ratio: 4 / 3;
      background:#ddd;
    }
    .card .thumb img{
      width:100%;
      height:100%;
      object-fit: cover;
      display:block;
    }
    .card .meta{
      text-align:center;
      margin-top: 8px;
    }
    .card .meta .kicker{
      font-family: "Montserrat", sans-serif;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-size: 12px;
      color: var(--teal-800);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .card .meta .place{
      font-family: var(--serif);
      font-size: 18px;
      color: var(--teal-800);
      font-weight: 600;
      font-style: italic;
    }

    /* FOOTER */
    .footer{
      background: var(--teal-800);
      color: var(--cream);
      padding: 80px 0 72px;
      position:relative;
      overflow:hidden;
      box-shadow: inset 0 8px 28px rgba(0,0,0,.2);
    }
    .footer .wrap{
      position:relative;
    }
    .footer h3{
      margin: 0 0 18px;
      text-align:center;
      font-family: "Montserrat", sans-serif;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-size: 24px;
      font-weight: 600;
      color: var(--teal-400);
    }
    .footer .footer-title{
      text-align:center;
      font-family: var(--serif);
      font-size: 24px;
      margin: 0 0 20px;
    }

    .footer p{
      margin: 0 auto 14px;
      text-align:center;
      font-size: 18px;
      font-weight: 400;
      max-width: 76ch;
      color: var(--cream);
    }
    .socials{
      display:flex;
      justify-content:center;
      gap: 14px;
      margin-top: 28px;
    }
    .icon-btn{
      width: 52px;
      height: 52px;
      border-radius: 999px;
      display:grid;
      place-items:center;
      border: 1.5px solid rgba(64,255,181,.25);
      background: rgba(64,255,181,.08);
      transition: transform .18s ease, background .18s ease;
      text-decoration:none;
    }
    .icon-btn:hover{
      transform: translateY(-2px);
      background: rgba(64,255,181,.16);
    }
    .icon-btn svg{
      width: 22px;
      height: 22px;
      fill: var(--teal-400);
    }

    /* right-side vertical branding */
    .watermark{
      display:none;
    }
    .footer-branding{
     position: absolute;
  top: 2%;
  right: 50px;

  /* MUST have a real box for background to render */
  width: 420px;     /* your horizontal image width (tweak) */
  height: 90px;     /* your horizontal image height (tweak) */

  transform: translateY(-50%) rotate(-90deg);
  transform-origin: right center;

  background: url("assets/footer-branding.png") center / contain no-repeat;
  opacity: .25;
  pointer-events: none;
  z-index: 2;
    }

    /* Responsive */
    @media (max-width: 980px){
      .two-col{ grid-template-columns: 1fr; }
      .body-copy{ max-width: unset; }
      .cards{ grid-template-columns: 1fr; }
      .hero{ min-height: 520px; }
      .watermark{ display:none; }
      .footer-branding{ display:none; }
      .services-grid{ grid-template-columns: 1fr; }
      .service-card{ max-width: 520px; margin: 0 auto; }
      .footer .wrap{ padding-right: var(--gutter); }
    }

    @media (max-width: 520px){
      :root{ --gutter: 18px; }
      .section{ padding: 58px 0; }
      .hero-inner{
        padding: 80px var(--gutter) 48px;
      }
      .hero-kicker{ letter-spacing: .2em; }
      .hero-btn{ padding: 11px 18px; }
      .title-script{ font-size: 36px; }
      .exp-title{ font-size: 36px; }
      .service-name{ font-size: 20px; }
      .service-meta{ font-size: 11px; }
      .service-copy{ font-size: 13px; }
      .service-btn{ width: 100%; max-width: 320px; }
    }
    </style>
  </Fragment>

  <!-- HERO -->
  <header class="hero">
    <div class="wrap hero-inner">
      <p class="hero-kicker">G R E E T I N G S&nbsp;&nbsp;W A N D E R E R</p>
      <p class="hero-we-are">We are</p>
      <h1 class="hero-title">bifunctional</h1>
      <p class="hero-subtitle">
        A Berlin-based freelance studio guiding founders from<br>
        idea to design, build, and launch <span class="hero-flag">🇩🇪</span><br>
        <span style="font-size:18px;opacity:.82;">Product, data, design &amp; emerging technology for early-stage teams</span>
      </p>
      <a class="hero-btn" href="#learn-more">Learn More</a>
    </div>
  </header>

  <!-- STUDIO SERVICES -->
  <section id="services" class="section services">
    <div class="wrap">
      <div class="services-header">
        <h2 class="services-title">Boutique Studio Offerings</h2>
        <p class="services-subtitle">A founder-led freelance unit for product, software, data, and design delivery</p>
      </div>

      <div class="services-grid">
        <article class="service-card">
          <div class="service-icon">🚀</div>
          <h3 class="service-name">Venture Kick-Starter</h3>
          <p class="service-meta">1 week | 10 hours</p>
          <p class="service-copy">For founders who need a sharp technical and product partner to move from idea to first working version.</p>
          <p class="service-copy">
            Over one focused week, we shape and implement a practical launch foundation: website,
            prototype, tooling, automation workflow, customer intelligence, or lead-gen infrastructure,
            scoped around what creates real momentum fastest.
          </p>
          <p class="service-price">€800</p>
        </article>

        <article class="service-card">
          <div class="service-icon">🎨</div>
          <h3 class="service-name">Brand Design Package</h3>
          <p class="service-meta">1 week | 4 hrs</p>
          <p class="service-copy">For founders who need a visual identity that feels considered, usable, and ready to ship.</p>
          <p class="service-copy">
            We collaborate to define your core identity system: logo direction,
            visual assets, AI-assisted illustration, and digital style guidelines tailored to your
            product, audience, and ambitions.
          </p>
          <p class="service-price">€400</p>
        </article>

        <article class="service-card">
          <div class="service-icon">⚙️</div>
          <h3 class="service-name">Custom Work Packages</h3>
          <p class="service-meta">Flexible duration | Tailored scope</p>
          <p class="service-copy">For an existing business, venture, or startup that needs focused technical execution without hiring a full in-house team.</p>
          <p class="service-copy">
            We design and implement bespoke work packages to add software features, automation layers,
            data workflows, or intelligent systems to your existing website, product, or service operation.
          </p>
          <p class="service-price">Custom pricing</p>
        </article>
      </div>

      <div class="services-cta">
        <a class="service-btn" href="#contact">Book a Call</a>
      </div>
    </div>
  </section>

  <!-- ZUBIN -->
  <section id="learn-more" class="section panel-cream">
    <div class="wrap">
      <div class="two-col">
        <div>
          <h2 class="heading-small">Hey. I'm Zubin</h2>
          <p class="subcaps">DATA PRACTITIONER,</p>
          <p class="subcaps">ASPIRING TECHNOLOGIST</p>
          <p class="subcaps">AND ALL-ROUND NERD</p>

          <p class="body-copy">
            I work across product, data, software, and early-stage venture building. Bifunctional is the commercial layer for the systems I help founders design, build, and ship. In my spare time, I write about technology, data, systems, and computer theory through my volunteering and teaching work across Berlin's tech + community ecosystem.
          </p>
          <a class="section-cta section-cta-cream" href="https://blog.bifunctional.xyz">Visit My Blog</a>
        </div>

        <div class="media" aria-label="Zubin photo">
          <img src="assets/images/00z.jpg" alt="Hey Zubin" />
        </div>
      </div>
    </div>
  </section>

  <!-- SAUMYA / DESIGN WITH PURPOSE -->
  <section class="section panel-dark">
    <div class="wrap">
      <div class="two-col">
        <div>
          <h2 class="title-script">Design with Purpose</h2>
          <p class="subcaps">EMPATHY IN EVERY PIXEL</p>

          <p class="body-copy">
            Saumya brings the design layer to selected projects: research sensitivity, visual clarity, and human-centered thinking. Together, we operate as a small freelance unit for boutique builds that need both structure and soul.
          </p>
          <a class="section-cta section-cta-dark" href="#services">View My Work</a>
        </div>

        <div class="media portrait-circle" aria-label="Saumya photo">
          <img src="assets/images/01s.jpg" alt="Saumya — placeholder image" />
        </div>
      </div>
    </div>
  </section>

  <!-- EXPEDITIONS + TRAVEL -->
  <section id="expeditions" class="section panel-pink">
    <div class="wrap">
      <h2 class="exp-title">Expeditions</h2>
      <p class="travel-title">LIKE EVERY OTHER BORING TECH DUO WE ALSO BLOG ABOUT TRAVEL</p>

      <div class="travel-hero">
        <div class="media">
          <img src="assets/images/02c.jpg" alt="Zubin and Saumya" />
        </div>
        <p class="caption">
          Yes, we're married. tied the knot in 2019 — been travelling, freelancing &amp; building startups together ever since.
        </p>
      </div>

      <div class="services-cta">
        <a class="service-btn blog-link" href="expeditions/">To Expeditions</a>
      </div>
    </div>
  </section>

</BaseLayout>
