---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Expeditions">
  <Fragment slot="head">
    <style is:inline>
    :root{
      --black: #1b1b1b;
      --muted: rgba(27,27,27,.58);
      --bg: #ffffff;
      --border: rgba(27,27,27,.10);
      --max: 1120px;
      --gutter: 28px;
      --serif: "Fraunces", serif;
      --caps: "Cormorant Garamond", serif;
      --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
      --shadow-soft: 0 10px 30px rgba(0,0,0,.10);
      --radius-lg: 14px;
    }
    *{box-sizing:border-box;}
    body{
      margin:0;
      background: #efede7;
      color: var(--black);
      font-family: var(--sans);
      line-height: 1.5;
    }
    .wrap{
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter);
    }

    /* NAV */
    .exp-nav{
      display:flex;
      align-items:center;
      padding: 20px var(--gutter);
      max-width: var(--max);
      margin: 0 auto;
      border-bottom: 1px solid rgba(27,27,27,.08);
    }
    .exp-nav .back{
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--black);
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      gap: 6px;
      opacity: .65;
      transition: opacity .15s;
    }
    .exp-nav .back:hover{ opacity:1; }

    /* HEADER */
    .exp-header{
      text-align:center;
      padding: 56px var(--gutter) 16px;
    }
    .exp-kicker{
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: #00634d;
      opacity: .7;
      margin: 0 0 14px;
    }
    .exp-title{
      font-family: var(--serif);
      font-weight: 500;
      font-style: italic;
      font-size: clamp(40px, 6vw, 68px);
      letter-spacing: .01em;
      margin: 0;
      color: var(--black);
      line-height: 1.05;
    }
    .exp-rule{
      width: 40px;
      height: 3px;
      background: #00634d;
      border-radius: 2px;
      margin: 18px auto 16px;
    }
    .exp-subtitle{
      font-family: var(--caps);
      font-size: 17px;
      font-weight: 500;
      color: var(--muted);
      margin: 0;
      letter-spacing: .04em;
    }

    /* HERO */
    .travel-hero{
      max-width: 560px;
      margin: 32px auto 0;
      text-align:center;
    }
    .travel-hero .media{
      width:100%;
      border-radius: var(--radius-lg);
      overflow:hidden;
      aspect-ratio: 1 / 1;
      box-shadow: var(--shadow-soft);
      background:#eee;
    }
    .travel-hero img{ width:100%; height:100%; object-fit:cover; display:block; }
    .caption{
      font-family: var(--serif);
      font-size: 13px;
      color: var(--muted);
      margin: 14px auto 0;
      max-width: 60ch;
      font-style: italic;
      text-align:center;
      line-height: 1.5;
    }

    /* DIVIDER */
    .divider{
      width: 60px;
      height: 1px;
      background: var(--border);
      margin: 44px auto;
    }

    /* STORIES SECTION */
    .stories-header{
      text-align:center;
      margin-bottom: 28px;
    }
    .stories-title{
      font-family: var(--sans);
      font-weight: 800;
      font-size: 28px;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin: 0 0 6px;
      color: var(--black);
    }
    .stories-sub{
      font-family: var(--caps);
      font-size: 15px;
      font-weight: 500;
      color: var(--muted);
      margin: 0;
      letter-spacing: .04em;
    }

    /* STORY GRID */
    .story-grid{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    .story-card{
      position:relative;
      display:block;
      border-radius: 12px;
      overflow:hidden;
      aspect-ratio: 4 / 5;
      background: #c8d8d2 center/cover no-repeat;
      text-decoration:none;
      box-shadow: var(--shadow-soft);
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .story-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 18px 40px rgba(0,0,0,.18);
    }
    .story-overlay{
      position:absolute;
      inset:0;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      padding: 24px 20px;
      background: linear-gradient(to top, rgba(0,0,0,.74) 0%, rgba(0,0,0,.15) 50%, transparent 100%);
      color: #fff;
    }
    .story-badge{
      position:absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      background: rgba(255,255,255,.18);
      backdrop-filter: blur(6px);
      padding: 5px 14px;
      border-radius: 6px;
      white-space:nowrap;
    }
    .story-title{
      font-family: var(--sans);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin: 0 0 4px;
    }
    .story-subtitle{
      font-family: var(--serif);
      font-style: italic;
      font-size: 13px;
      margin: 0 0 6px;
      opacity: .88;
    }
    .story-date{
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: .12em;
      text-transform: uppercase;
      opacity: .68;
    }

    /* BACK LINK */
    .back-link{
      display:inline-block;
      margin-top: 36px;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 13px;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--black);
      text-decoration:none;
      border-bottom: 1.5px solid var(--border);
      padding-bottom: 3px;
      transition: opacity .15s;
    }
    .back-link:hover{ opacity:.6; }

    @media (max-width: 780px){
      .story-grid{ grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
      .travel-hero{ max-width: 100%; }
      .exp-header{ padding-top: 32px; }
    }
    </style>
  </Fragment>

  <!-- NAV -->
  <nav class="exp-nav">
    <a class="back" href="../">← Back to <strong>Home</strong></a>
  </nav>

  <!-- HEADER -->
  <header class="exp-header">
    <p class="exp-kicker">S &amp; Z &mdash; Berlin</p>
    <h1 class="exp-title">Expeditions</h1>
    <div class="exp-rule"></div>
    <p class="exp-subtitle">Like every other boring tech duo, we also blog about travel</p>
  </header>

  <section>
    <div class="wrap">
      <div class="travel-hero">
        <div class="media">
          <img src="/assets/images/00f.jpg" alt="Family travel photo" />
        </div>
        <p class="caption">
          A family-postcard selfie with the backdrop of the Marble Mountains, found in central Vietnam,
          a short excursion from Da Nang or Hoi An.
        </p>
      </div>

      <div class="divider"></div>

      <!-- PUBLISHED STORIES -->
      <div class="stories-header">
        <h2 class="stories-title">Published Stories</h2>
        <p class="stories-sub">A preview of some of our more recent trips and expeditions</p>
      </div>

      <div class="story-grid">
        <a class="story-card" href="/expeditions/salzburg/">
          <div class="story-overlay">
            <span class="story-badge">PUBLISHED</span>
            <h3 class="story-title">Into the Alps: Salzburg</h3>
            <p class="story-subtitle">Weekend getaway options in the Austrian Alps</p>
            <time class="story-date">October 9<sup>th</sup>, 2021</time>
          </div>
        </a>
        <a class="story-card" href="/expeditions/innsbruck/">
          <div class="story-overlay">
            <span class="story-badge">PUBLISHED</span>
            <h3 class="story-title">Into the Alps: Innsbruck</h3>
            <p class="story-subtitle">Weekend getaway options in the Austrian Alps</p>
            <time class="story-date">October 9<sup>th</sup>, 2021</time>
          </div>
        </a>
        <a class="story-card" href="/expeditions/verona/">
          <div class="story-overlay">
            <span class="story-badge">PUBLISHED</span>
            <h3 class="story-title">Verona</h3>
            <p class="story-subtitle">Of Bridges &amp; Brawls</p>
            <time class="story-date">October 8<sup>th</sup>, 2020</time>
          </div>
        </a>
        <a class="story-card" href="/posts/travelblogpost/" style="background-image:url('../images/expeditions/thailand-temple.jpg')">
          <div class="story-overlay">
            <span class="story-badge">PUBLISHED</span>
            <h3 class="story-title">Bangkok Airwaves</h3>
            <p class="story-subtitle">Glimpses of Thailand 2018</p>
            <time class="story-date">March 24<sup>th</sup>, 2019</time>
          </div>
        </a>
        <a class="story-card" href="/posts/travelblogpost/" style="background-image:url('../images/expeditions/thailand.jpg')">
          <div class="story-overlay">
            <span class="story-badge">PUBLISHED</span>
            <h3 class="story-title">Andaman Sands</h3>
            <p class="story-subtitle">Glimpses of Thailand 2018</p>
            <time class="story-date">January 7<sup>th</sup>, 2019</time>
          </div>
        </a>
        <a class="story-card" href="#" style="background-image:url('../images/expeditions/bruges.jpg')" aria-label="In Bruges via Ghent and Cologne - coming soon">
          <div class="story-overlay">
            <span class="story-badge">PUBLISHED</span>
            <h3 class="story-title">In Bruges via Ghent &amp; Cologne</h3>
            <p class="story-subtitle">European Rail Trails: Volume II</p>
            <time class="story-date">January 7<sup>th</sup>, 2019</time>
          </div>
        </a>
      </div>

      <a class="back-link" href="../">← Back to Home</a>
    </div>
  </section>

  <div style="height:64px"></div>
</BaseLayout>
