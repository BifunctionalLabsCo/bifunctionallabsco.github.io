---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Legal Notice | Bifunctional Labs">
  <Fragment slot="head">
    <style is:inline>
      :root{
        --black: #1b1b1b;
        --muted: rgba(27,27,27,.66);
        --bg: #ffffff;
        --max: 1120px;
        --text: 760px;
        --gutter: 28px;
        --serif: "Fraunces", serif;
        --caps: "Cormorant Garamond", serif;
        --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      *{ box-sizing:border-box; }
      body{
        margin:0;
        background: var(--bg);
        color: var(--black);
        font-family: var(--sans);
        line-height: 1.6;
      }
      .wrap{
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }
      .legal{
        padding: 72px 0 84px;
      }
      .legal h1{
        margin: 0;
        font-family: var(--serif);
        font-style: italic;
        font-size: clamp(34px, 5vw, 48px);
        color: var(--black);
      }
      .lede{
        margin: 14px 0 0;
        font-family: var(--caps);
        font-size: 21px;
        font-weight: 600;
        color: var(--muted);
        max-width: 60ch;
      }
      .content{
        max-width: var(--text);
        margin-top: 34px;
      }
      .block + .block{
        margin-top: 22px;
      }
      .label{
        margin: 0 0 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      p{
        margin: 0;
        font-size: 16px;
      }
      a{
        color: var(--black);
      }
      @media (max-width: 520px){
        :root{ --gutter: 18px; }
        .legal{
          padding: 56px 0 64px;
        }
        .lede{
          font-size: 19px;
        }
      }
    </style>
  </Fragment>

  <main class="legal">
    <div class="wrap">
      <h1>Legal Notice</h1>
      <p class="lede">A minimal legal notice for Bifunctional Labs as a founder-led freelance studio.</p>
      <section class="content" aria-label="Legal notice details">
        <div class="block">
          <p class="label">Operator</p>
          <p>Zubin John</p>
        </div>
        <div class="block">
          <p class="label">Location</p>
          <p>Berlin, Germany</p>
        </div>
        <div class="block">
          <p class="label">Contact</p>
          <p><a href="mailto:bifunctionallabsco@gmail.com">bifunctionallabsco@gmail.com</a></p>
        </div>
        <div class="block">
          <p class="label">Operational status</p>
          <p>Bifunctional Labs currently operates as a freelance studio and independent consulting practice.</p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
