---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | Bifunctional Labs"
  description="Privacy policy for Bifunctional Labs Co."
  robots="noindex, follow"
>
  <Fragment slot="head">
    <style is:inline>
      :root{
        --cream: #efede7;
        --teal-400: #40ffb5;
        --teal-800: #032b22;
        --muted: rgba(239,237,231,.76);
        --bg: #032b22;
        --max: 1120px;
        --text: 760px;
        --gutter: 28px;
        --serif: "Fraunces", serif;
        --caps: "Cormorant Garamond", serif;
        --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      *{ box-sizing:border-box; }
      body{
        margin:0;
        background: var(--bg);
        color: var(--cream);
        font-family: var(--sans);
        line-height: 1.6;
      }
      .wrap{
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }
      .policy{
        padding: 72px 0 84px;
      }
      .policy h1{
        margin: 0;
        font-family: var(--serif);
        font-style: italic;
        font-size: clamp(34px, 5vw, 48px);
      }
      .lede{
        margin: 14px 0 0;
        font-family: var(--caps);
        font-size: 21px;
        font-weight: 600;
        color: var(--muted);
        max-width: 62ch;
      }
      .policy h1{
        color: var(--cream);
      }
      .content{
        max-width: var(--text);
        margin-top: 32px;
      }
      p{
        margin: 0;
        font-size: 16px;
      }
      .content p + p{
        margin-top: 14px;
      }
      a{
        color: var(--teal-400);
      }
      @media (max-width: 520px){
        :root{ --gutter: 18px; }
        .policy{
          padding: 56px 0 64px;
        }
        .lede{
          font-size: 19px;
        }
      }
    </style>
  </Fragment>

  <main class="policy">
    <div class="wrap">
      <h1>Privacy Policy</h1>
      <p class="lede">This page describes how data is handled on the current Bifunctional Labs website.</p>
      <section class="content" aria-label="Privacy details">
        <p>This is a static informational website for a small founder-led freelance studio and consulting practice.</p>
        <p>The site currently does not intentionally use analytics, tracking pixels, or advertising cookies, and it does not provide user accounts.</p>
        <p>We currently do not intentionally use tracking or advertising cookies.</p>
        <p>Like most websites, basic server logs may be generated by hosting or infrastructure providers for security and operational reliability.</p>
        <p>Contact currently happens via <a href="mailto:bifunctionallabsco@gmail.com">mailto links</a>. If you choose to email, your email address and any information you include are shared voluntarily.</p>
        <p>As systems evolve, this policy may be updated to reflect any material changes to tools, workflows, or data handling.</p>
      </section>
    </div>
  </main>
</BaseLayout>
