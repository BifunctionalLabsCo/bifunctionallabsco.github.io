---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum | Bifunctional Labs">
  <Fragment slot="head">
    <style is:inline>
      :root{
        --cream: #efede7;
        --teal-400: #40ffb5;
        --teal-800: #032b22;
        --muted: rgba(239,237,231,.76);
        --bg: #032b22;
        --max: 1120px;
        --text: 760px;
        --gutter: 28px;
        --serif: "Fraunces", serif;
        --caps: "Cormorant Garamond", serif;
        --sans: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      *{ box-sizing:border-box; }
      body{
        margin:0;
        background: var(--bg);
        color: var(--cream);
        font-family: var(--sans);
        line-height: 1.6;
      }
      .wrap{
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }
      .legal{
        padding: 72px 0 84px;
      }
      .legal h1{
        margin: 0;
        font-family: var(--serif);
        font-style: italic;
        font-size: clamp(34px, 5vw, 48px);
        color: var(--cream);
      }
      .lede{
        margin: 14px 0 0;
        font-family: var(--caps);
        font-size: 21px;
        font-weight: 600;
        color: var(--teal-400);
        max-width: 60ch;
      }
      .content{
        max-width: var(--text);
        margin-top: 34px;
      }
      .block + .block{
        margin-top: 22px;
      }
      .label{
        margin: 0 0 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      p{
        margin: 0;
        font-size: 16px;
      }
      .block p + p{
        margin-top: 8px;
      }
      a{
        color: var(--teal-400);
      }
      @media (max-width: 520px){
        :root{ --gutter: 18px; }
        .legal{
          padding: 56px 0 64px;
        }
        .lede{
          font-size: 19px;
        }
      }
    </style>
  </Fragment>

  <main class="legal">
    <div class="wrap">
      <h1>Impressum</h1>
      <p class="lede">Information according to § 5 TMG for a founder-led freelance studio.</p>
      <section class="content" aria-label="Impressum details">
        <div class="block">
          <p class="label">Information according to § 5 TMG</p>
          <p>Bifunctional Labs (freelance studio initiative)</p>
          <p>Zubin John</p>
          <p>Berlin, Germany</p>
        </div>
        <div class="block">
          <p class="label">Contact</p>
          <p><a href="mailto:bifunctionallabsco@gmail.com">bifunctionallabsco@gmail.com</a></p>
          <p>Website: <a href="https://bifunctional.xyz">bifunctional.xyz</a></p>
        </div>
        <div class="block">
          <p class="label">Operational status</p>
          <p>Bifunctional Labs currently operates as a freelance studio and independent consulting practice.</p>
        </div>
        <div class="block">
          <p class="label">Responsible for content according to § 55 para. 2 RStV / § 18 para. 2 MStV</p>
          <p>Zubin John, Berlin, Germany</p>
        </div>
        <div class="block">
          <p class="label">Disclaimer</p>
          <p>The content of this website is created with care. However, no guarantee is given for accuracy, completeness, or current validity.</p>
          <p>As a service provider, we are responsible for our own content in accordance with general laws. We are not obliged to monitor transmitted or stored third-party information on an ongoing basis.</p>
        </div>
        <div class="block">
          <p class="label">Copyright</p>
          <p>Content and works created on this website are subject to German copyright law. Reproduction, editing, distribution, or use beyond copyright limits requires prior written consent of the respective author.</p>
        </div>
        <div class="block">
          <p class="label">Data protection</p>
          <p>Use of this website is generally possible without actively providing personal data. If personal data is provided voluntarily (for example via email), it is processed only for communication and operational purposes.</p>
          <p>Please note that data transmission over the internet (for example via email) can have security gaps. Complete protection of data from third-party access is not possible.</p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
